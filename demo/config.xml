<?xml version='1.0' encoding='utf-8'?>
<widget id="io.github.maximbelov.sentry.demo" version="1.0.0" xmlns="http://www.w3.org/ns/widgets" xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- No Kotlin and no deployment-target preference here, on purpose: the demo is the bare app the plugin has to work in. The plugin
         asks for what it needs (Kotlin on Android, iOS 15) through its own plugin.xml, and test/e2e proves that it does. -->
    <name>SentryDemo</name>
    <description>Demo of cordova-plugin-sentry-sdk: one button per call, the answer of each shown on screen</description>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <!-- the SDK talks to Sentry's ingest hosts -->
    <access origin="*" />
    <platform name="ios">
        <preference name="Orientation" value="portrait" />
        <!-- test/e2e points the DSN at an ingest endpoint on this machine, which speaks plain http. -->
        <edit-config file="*-Info.plist" mode="merge" target="NSAppTransportSecurity">
            <dict>
                <key>NSAllowsLocalNetworking</key>
                <true/>
            </dict>
        </edit-config>
    </platform>
    <platform name="android">
        <!-- test/e2e points the DSN at an ingest endpoint on this machine, which speaks plain http. One attribute: a multi-attribute
             edit-config here is re-applied one attribute per prepare, and the others are lost. -->
        <edit-config file="app/src/main/AndroidManifest.xml" mode="merge" target="/manifest/application">
            <application android:usesCleartextTraffic="true" />
        </edit-config>
    </platform>
</widget>
