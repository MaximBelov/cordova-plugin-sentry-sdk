<?xml version='1.0' encoding='utf-8'?>
<widget id="io.github.maximbelov.sentry.demo" version="1.0.0" xmlns="http://www.w3.org/ns/widgets">
    <name>SentryDemo</name>
    <description>Demo of cordova-plugin-sentry-sdk: one button per call, the answer of each shown on screen</description>
    <content src="index.html" />
    <allow-intent href="http://*/*" />
    <allow-intent href="https://*/*" />
    <!-- the SDK talks to Sentry's ingest hosts -->
    <access origin="*" />
    <platform name="ios">
        <preference name="deployment-target" value="15.0" />
        <preference name="SwiftVersion" value="5.9" />
        <preference name="Orientation" value="portrait" />
    </platform>
    <platform name="android">
        <preference name="GradlePluginKotlinEnabled" value="true" />
        <preference name="GradlePluginKotlinVersion" value="2.1.0" />
        <preference name="AndroidXEnabled" value="true" />
    </platform>
</widget>
